<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>host.springboot.framework</groupId>
        <artifactId>krismile-boot3-framework</artifactId>
        <version>0.2.0</version>
    </parent>

    <artifactId>krismile-boot3-bom</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>

    <url>https://www.springboot.host</url>
    <inceptionYear>2025</inceptionYear>

    <licenses>
        <license>
            <name>Apache 2</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
            <comments>A business-friendly OSS license</comments>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>JiYinchuan</name>
            <email>jyc@krismile.cn</email>
            <roles>
                <role>Project Manager</role>
            </roles>
            <organization>Krismile</organization>
            <organizationUrl>https://www.krismile.cn</organizationUrl>
            <timezone>+8</timezone>
        </developer>
    </developers>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>host.springboot.framework</groupId>
                <artifactId>krismile-boot3-core</artifactId>
                <version>${krismile.boot.core.version}</version>
            </dependency>
            <dependency>
                <groupId>host.springboot.framework</groupId>
                <artifactId>krismile-boot3-context</artifactId>
                <version>${krismile.boot.context.version}</version>
            </dependency>
            <dependency>
                <groupId>host.springboot.framework</groupId>
                <artifactId>krismile-boot3-autoconfigure</artifactId>
                <version>${krismile.boot.autoconfigure.version}</version>
            </dependency>
            <dependency>
                <groupId>host.springboot.framework</groupId>
                <artifactId>krismile-boot3-starter-mybatisplus</artifactId>
                <version>${krismile.boot.starter-mybatisplus.version}</version>
            </dependency>
            <dependency>
                <groupId>host.springboot.framework</groupId>
                <artifactId>krismile-boot3-starter-redis</artifactId>
                <version>${krismile.boot.starter-redis.version}</version>
